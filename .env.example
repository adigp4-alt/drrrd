# Alpaca competition paper account (never commit real values)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_AUTOTRADE_ENABLED=false
AGENT_RUN_TOKEN=replace-with-a-long-random-value

# Choose exactly one provider; the other can remain unset.
AGENT_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.2

# Optional override. By default the app launches the installed package with
# the same Python interpreter, which works locally, in Docker, and on Render.
ALPACA_MCP_COMMAND=
ALPACA_MCP_ARGS=
